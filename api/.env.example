# HTTP
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# In development, Angular normally runs on this origin. In production use the
# exact HTTPS origin of the admin panel, without a trailing slash.
CORS_ORIGIN=http://localhost:4200
COOKIE_SECURE=false

# Bootstrap account. The plain password is only read at startup to create the
# first account. The database stores an Argon2id hash, never this value.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Persistent API data: SQLite database, staged requests and job logs.
API_DATA_DIR=/var/lib/cienciaceleste

# Mounted checkout containing package.json, build/, frontend/ and tools/.
PROJECT_ROOT=/workspace/cienciaceleste

# The API only invokes these fixed npm scripts. Do not turn them into request
# parameters or accept arbitrary commands through HTTP.
DOCS_BUILD_TASK=build:all:docs
DEPLOY_SCRIPT=frontend:deploy:ghpages
DEPLOY_ENABLED=true

SESSION_TTL_HOURS=8
JOB_POLL_INTERVAL_MS=500
PIPELINE_TIMEOUT_MS=1800000
LOG_LEVEL=info
